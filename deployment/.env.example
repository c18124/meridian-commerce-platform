# Copy OUTSIDE the repository; replace placeholders and use a NEW Compose name.
COMPOSE_PROJECT_NAME=global-store-demo
HTTP_PORT=8080
MYSQL_DATABASE=ai_chat
MYSQL_USER=global_store
MYSQL_PASSWORD=replace_with_new_random_password
MYSQL_ROOT_PASSWORD=replace_with_different_random_root_password
DATABASE_URL_DOCKER=mysql+pymysql://global_store:replace_with_new_random_password@mysql:3306/ai_chat
DEEPSEEK_API_KEY=replace_with_your_existing_key
HF_CACHE_DIR=C:/Users/YOUR_USER/.cache/huggingface
